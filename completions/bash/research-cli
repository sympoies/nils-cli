        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="research__cli"
                ;;
            research__cli,brief)
                cmd="research__cli__brief"
                ;;
            research__cli,completion)
                cmd="research__cli__completion"
                ;;
            research__cli,help)
                cmd="research__cli__help"
                ;;
            research__cli,read-url)

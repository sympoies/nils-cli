_speech__test__cli() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="speech__test__cli"
                ;;
            speech__test__cli,completion)
                cmd="speech__test__cli__completion"
                ;;
            speech__test__cli,generate)
                cmd="speech__test__cli__generate"
                ;;
            speech__test__cli,help)
                cmd="speech__test__cli__help"
                ;;
            speech__test__cli,replay)
                cmd="speech__test__cli__replay"
                ;;
            speech__test__cli,review)
                cmd="speech__test__cli__review"
                ;;
            speech__test__cli,score)
                cmd="speech__test__cli__score"
                ;;
            speech__test__cli__help,completion)
                cmd="speech__test__cli__help__completion"
                ;;
            speech__test__cli__help,generate)
                cmd="speech__test__cli__help__generate"
                ;;
            speech__test__cli__help,help)
                cmd="speech__test__cli__help__help"
                ;;
            speech__test__cli__help,replay)
                cmd="speech__test__cli__help__replay"
                ;;
            speech__test__cli__help,review)
                cmd="speech__test__cli__help__review"
                ;;
            speech__test__cli__help,score)
                cmd="speech__test__cli__help__score"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        speech__test__cli)
            opts="-h -V --format --help --version generate review replay score completion help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --format)
                    COMPREPLY=($(compgen -W "text json" -- "${cur}"))
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        speech__test__cli__completion)
            opts="-h --format --help bash zsh"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --format)

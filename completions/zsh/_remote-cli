#compdef remote-cli

autoload -U is-at-least

_remote-cli() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_remote-cli_commands" \
"*::: :->remote-cli" \
&& ret=0
    case $state in
    (remote-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:remote-cli-command-$line[1]:"
        case $line[1] in
            (exec)
_arguments "${_arguments_options[@]}" : \
'--cwd=[Remote working directory (defaults to remote home)]:DIR:_default' \
'--timeout=[Wall-clock timeout in seconds (0 disables the deadline)]:S:_default' \
'--connect-timeout=[OpenSSH connect timeout in seconds]:S:_default' \
'--shell=[Remote shell executable (defaults to the remote login shell)]:SHELL:_default' \
'--sudo-user=[Run sudo as this user (requires --sudo)]:SUDO_USER:_default' \
'--stdin-file=[Send this local file to the remote command on stdin]:STDIN_FILE:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--sudo[Run the command via non-interactive sudo]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':host -- OpenSSH host alias or user@host:_default' \
'*::argv -- Remote program and literal arguments, after --:_cmdambivalent' \
&& ret=0
;;
(shell)
_arguments "${_arguments_options[@]}" : \
'--cwd=[Remote working directory (defaults to remote home)]:DIR:_default' \
'--timeout=[Wall-clock timeout in seconds (0 disables the deadline)]:S:_default' \
'--connect-timeout=[OpenSSH connect timeout in seconds]:S:_default' \
'--shell=[Remote shell executable (defaults to the remote login shell)]:SHELL:_default' \
'--script-file=[Local script file to send on stdin]:SCRIPT_FILE:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--sudo[Run the command via non-interactive sudo]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':host -- OpenSSH host alias or user@host:_default' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_remote-cli__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:remote-cli-help-command-$line[1]:"
        case $line[1] in
            (exec)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(shell)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_remote-cli_commands] )) ||
_remote-cli_commands() {
    local commands; commands=(
'exec:Run a remote command with literal arguments' \
'shell:Run a local script on the remote host through stdin' \
'completion:Print a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'remote-cli commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__completion_commands] )) ||
_remote-cli__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'remote-cli completion commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__exec_commands] )) ||
_remote-cli__subcmd__exec_commands() {
    local commands; commands=()
    _describe -t commands 'remote-cli exec commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__help_commands] )) ||
_remote-cli__subcmd__help_commands() {
    local commands; commands=(
'exec:Run a remote command with literal arguments' \
'shell:Run a local script on the remote host through stdin' \
'completion:Print a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'remote-cli help commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__help__subcmd__completion_commands] )) ||
_remote-cli__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'remote-cli help completion commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__help__subcmd__exec_commands] )) ||
_remote-cli__subcmd__help__subcmd__exec_commands() {
    local commands; commands=()
    _describe -t commands 'remote-cli help exec commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__help__subcmd__help_commands] )) ||
_remote-cli__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'remote-cli help help commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__help__subcmd__shell_commands] )) ||
_remote-cli__subcmd__help__subcmd__shell_commands() {
    local commands; commands=()
    _describe -t commands 'remote-cli help shell commands' commands "$@"
}
(( $+functions[_remote-cli__subcmd__shell_commands] )) ||
_remote-cli__subcmd__shell_commands() {
    local commands; commands=()
    _describe -t commands 'remote-cli shell commands' commands "$@"
}

if [ "$funcstack[1]" = "_remote-cli" ]; then
    _remote-cli "$@"
else
    compdef _remote-cli remote-cli
fi

#compdef research-cli

autoload -U is-at-least

_research-cli() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Primary output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_research-cli_commands" \
"*::: :->research-cli" \
&& ret=0
    case $state in
    (research-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:research-cli-command-$line[1]:"
        case $line[1] in
            (search)
_arguments "${_arguments_options[@]}" : \
'--provider=[Provider to use, without changing the caller schema]:PROVIDER:(openai anthropic)' \
'--language=[Requested answer language (best effort)]:LANGUAGE:_default' \
'*--domain=[Restrict returned source domains; repeat for multiple domains]:DOMAINS:_default' \
'--recency-days=[Requested recency in days (best effort)]:RECENCY_DAYS:_default' \
'--limit=[Maximum number of returned sources]:LIMIT:_default' \
'--timeout-seconds=[Total research deadline in seconds]:TIMEOUT_SECONDS:_default' \
'--max-bytes=[Maximum bytes read per URL or provider response]:MAX_BYTES:_default' \
'--max-chars=[Maximum aggregate prose characters returned]:MAX_CHARS:_default' \
'--max-redirects=[Maximum redirects per public URL]:MAX_REDIRECTS:_default' \
'--max-output-tokens=[Requested model output token limit; aggregate usage may exceed it]:MAX_OUTPUT_TOKENS:_default' \
'--max-tool-uses=[Maximum uses of each configured server tool]:MAX_TOOL_USES:_default' \
'--format=[Primary output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':query -- Search query or research question:_default' \
&& ret=0
;;
(read-url)
_arguments "${_arguments_options[@]}" : \
'--timeout-seconds=[Total research deadline in seconds]:TIMEOUT_SECONDS:_default' \
'--max-bytes=[Maximum bytes read per URL or provider response]:MAX_BYTES:_default' \
'--max-chars=[Maximum aggregate prose characters returned]:MAX_CHARS:_default' \
'--max-redirects=[Maximum redirects per public URL]:MAX_REDIRECTS:_default' \
'--max-output-tokens=[Requested model output token limit; aggregate usage may exceed it]:MAX_OUTPUT_TOKENS:_default' \
'--max-tool-uses=[Maximum uses of each configured server tool]:MAX_TOOL_USES:_default' \
'--format=[Primary output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':url -- Public HTTP(S) URL to read:_urls' \
&& ret=0
;;
(brief)
_arguments "${_arguments_options[@]}" : \
'*--url=[Public evidence URL to read before synthesis; repeat as needed]:URLS:_urls' \
'*--field=[Requested synthesis topic; repeat as needed]:FIELDS:_default' \
'--provider=[Provider to use, without changing the caller schema]:PROVIDER:(openai anthropic)' \
'--language=[Requested answer language (best effort)]:LANGUAGE:_default' \
'*--domain=[Restrict returned source domains; repeat for multiple domains]:DOMAINS:_default' \
'--recency-days=[Requested recency in days (best effort)]:RECENCY_DAYS:_default' \
'--limit=[Maximum number of returned sources]:LIMIT:_default' \
'--timeout-seconds=[Total research deadline in seconds]:TIMEOUT_SECONDS:_default' \
'--max-bytes=[Maximum bytes read per URL or provider response]:MAX_BYTES:_default' \
'--max-chars=[Maximum aggregate prose characters returned]:MAX_CHARS:_default' \
'--max-redirects=[Maximum redirects per public URL]:MAX_REDIRECTS:_default' \
'--max-output-tokens=[Requested model output token limit; aggregate usage may exceed it]:MAX_OUTPUT_TOKENS:_default' \
'--max-tool-uses=[Maximum uses of each configured server tool]:MAX_TOOL_USES:_default' \
'--format=[Primary output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':query -- Search query or research question:_default' \
&& ret=0
;;
(serve)
_arguments "${_arguments_options[@]}" : \
'--bind=[HTTP listen address (loopback by default)]:BIND:_default' \
'--format=[Primary output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--format=[Primary output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- Shell to generate completion for:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_research-cli__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:research-cli-help-command-$line[1]:"
        case $line[1] in
            (search)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(read-url)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(brief)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(serve)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_research-cli_commands] )) ||
_research-cli_commands() {
    local commands; commands=(
'search:Search with a selected provider' \
'read-url:Read a public URL using plain HTTP, without a model call' \
'brief:Research a question, optionally reading URLs and requesting topics' \
'serve:Serve the same engine over a local HTTP endpoint' \
'completion:Export clap-generated shell completion' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'research-cli commands' commands "$@"
}
(( $+functions[_research-cli__brief_commands] )) ||
_research-cli__brief_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli brief commands' commands "$@"
}
(( $+functions[_research-cli__completion_commands] )) ||
_research-cli__completion_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli completion commands' commands "$@"
}
(( $+functions[_research-cli__help_commands] )) ||
_research-cli__help_commands() {
    local commands; commands=(
'search:Search with a selected provider' \
'read-url:Read a public URL using plain HTTP, without a model call' \
'brief:Research a question, optionally reading URLs and requesting topics' \
'serve:Serve the same engine over a local HTTP endpoint' \
'completion:Export clap-generated shell completion' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'research-cli help commands' commands "$@"
}
(( $+functions[_research-cli__help__brief_commands] )) ||
_research-cli__help__brief_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli help brief commands' commands "$@"
}
(( $+functions[_research-cli__help__completion_commands] )) ||
_research-cli__help__completion_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli help completion commands' commands "$@"
}
(( $+functions[_research-cli__help__help_commands] )) ||
_research-cli__help__help_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli help help commands' commands "$@"
}
(( $+functions[_research-cli__help__read-url_commands] )) ||
_research-cli__help__read-url_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli help read-url commands' commands "$@"
}
(( $+functions[_research-cli__help__search_commands] )) ||
_research-cli__help__search_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli help search commands' commands "$@"
}
(( $+functions[_research-cli__help__serve_commands] )) ||
_research-cli__help__serve_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli help serve commands' commands "$@"
}
(( $+functions[_research-cli__read-url_commands] )) ||
_research-cli__read-url_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli read-url commands' commands "$@"
}
(( $+functions[_research-cli__search_commands] )) ||
_research-cli__search_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli search commands' commands "$@"
}
(( $+functions[_research-cli__serve_commands] )) ||
_research-cli__serve_commands() {
    local commands; commands=()
    _describe -t commands 'research-cli serve commands' commands "$@"
}

if [ "$funcstack[1]" = "_research-cli" ]; then
    _research-cli "$@"
else
    compdef _research-cli research-cli
fi

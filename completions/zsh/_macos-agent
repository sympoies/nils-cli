#compdef macos-agent

autoload -U is-at-least

_macos-agent() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_macos-agent_commands" \
"*::: :->macos-agent" \
&& ret=0
    case $state in
    (macos-agent)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:macos-agent-command-$line[1]:"
        case $line[1] in
            (backend)
_arguments "${_arguments_options[@]}" : \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_macos-agent__subcmd__backend_commands" \
"*::: :->backend" \
&& ret=0

    case $state in
    (backend)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:macos-agent-backend-command-$line[1]:"
        case $line[1] in
            (install)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'--dry-run[Show the planned operation without changing backend state]' \
'--strict[Enforce the locked trust policy and disclose any exact notarization waiver]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'--strict[Enforce the locked trust policy and disclose any exact notarization waiver]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(rollback)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'--dry-run[Show the planned operation without changing backend state]' \
'--strict[Enforce the locked trust policy and disclose any exact notarization waiver]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(prune)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'--dry-run[Show the planned operation without changing backend state]' \
'--strict[Enforce the locked trust policy and disclose any exact notarization waiver]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'--strict[Fail when any required backend, Bridge, permission, or capability check is not ready]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(capabilities)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'--strict[Include live backend probes in addition to the static matrix]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(exec)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--out-dir=[Caller-owned directory for the structural execution journal]:OUT_DIR:_files' \
'--intent=[Concise operator intent; private values are redacted before persistence]:INTENT:_default' \
'--expected=[Observable postcondition expected by the caller]:EXPECTED:_default' \
'--evidence-mode=[Evidence retention and suppression mode]:EVIDENCE_MODE:(minimal debug sensitive)' \
'--runtime=[Permission/runtime authority used for this invocation]:RUNTIME:(app daemon auto process)' \
'--timeout-seconds=[Wall-clock bound for the upstream process]:TIMEOUT_SECONDS:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
'*::argv -- Peekaboo arguments, passed without grammar translation:_default' \
&& ret=0
;;
(mcp)
_arguments "${_arguments_options[@]}" : \
'--host=[Runtime-only trusted SSH target; never persisted]:HOST:_default' \
'--out-dir=[Caller-owned directory for the structural MCP journal]:OUT_DIR:_files' \
'--tool-profile=[Exact admitted tool family]:TOOL_PROFILE:(observe interact extended)' \
'--runtime=[Permission/runtime authority used for this server]:RUNTIME:(app daemon auto process)' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(journal)
_arguments "${_arguments_options[@]}" : \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_macos-agent__subcmd__journal_commands" \
"*::: :->journal" \
&& ret=0

    case $state in
    (journal)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:macos-agent-journal-command-$line[1]:"
        case $line[1] in
            (summarize)
_arguments "${_arguments_options[@]}" : \
'--out-dir=[Existing structural execution journal directory]:OUT_DIR:_files' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(review)
_arguments "${_arguments_options[@]}" : \
'--out-dir=[Existing structural execution journal directory]:OUT_DIR:_files' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(replay-plan)
_arguments "${_arguments_options[@]}" : \
'--out-dir=[Existing structural execution journal directory]:OUT_DIR:_files' \
'--step=[Optional journal step identifier to inspect]:STEP:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(replay-step)
_arguments "${_arguments_options[@]}" : \
'--out-dir=[Existing structural execution journal directory]:OUT_DIR:_files' \
'--step=[Journal step identifier to replay]:STEP:_default' \
'--current-snapshot=[Current caller-observed snapshot/state reference for conditional replay]:CURRENT_SNAPSHOT:_default' \
'--expected=[Fresh caller-observed postcondition required for conditional replay]:EXPECTED:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'--confirm-conditional[Acknowledge conditional replay after current-state checks]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh)' \
&& ret=0
;;
(__remote)
_arguments "${_arguments_options[@]}" : \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(__remote-mcp)
_arguments "${_arguments_options[@]}" : \
'--token=[]:TOKEN:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(__remote-cleanup)
_arguments "${_arguments_options[@]}" : \
'--token=[]:TOKEN:_default' \
'--format=[Human-readable or versioned JSON output]:FORMAT:(text json)' \
'--error-format=[Human-readable or versioned JSON errors on stderr]:ERROR_FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_macos-agent_commands] )) ||
_macos-agent_commands() {
    local commands; commands=(
'backend:Install, inspect, verify, or roll back the locked Peekaboo backend' \
'doctor:Verify backend integrity, runtime readiness, Bridge state, and permissions' \
'capabilities:Print the adapter capability and safety ceiling' \
'exec:Execute Peekaboo arguments verbatim after \`--\`' \
'mcp:Proxy Peekaboo'\''s stdio MCP server with a strict tool profile' \
'journal:Summarize, review, plan replay, or replay one guarded journal step' \
'completion:Print generated shell completion' \
'__remote:' \
'__remote-mcp:' \
'__remote-cleanup:' \
    )
    _describe -t commands 'macos-agent commands' commands "$@"
}

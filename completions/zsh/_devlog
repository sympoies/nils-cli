#compdef devlog

autoload -U is-at-least

_devlog() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--dir=[Devlog directory. Defaults to detecting docs/devlog or docs/source/devlog]:DIR:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_devlog_commands" \
"*::: :->devlog" \
&& ret=0
    case $state in
    (devlog)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:devlog-command-$line[1]:"
        case $line[1] in
            (new)
_arguments "${_arguments_options[@]}" : \
'--title=[Entry title, rendered after the date in the entry heading]:TITLE:_default' \
'--date=[Entry date (defaults to today)]:YYYY-MM-DD:_default' \
'*--result=[A \`Result\` bullet (repeatable)]:TEXT:_default' \
'*--why=[A \`Why / context\` bullet (repeatable)]:TEXT:_default' \
'*--evidence=[An \`Evidence\` bullet (repeatable)]:TEXT:_default' \
'*--link=[A \`Links\` bullet (repeatable; the section is omitted when empty)]:TEXT:_default' \
'*--follow-up=[A \`Follow-ups\` bullet (repeatable; the section is omitted when empty)]:TEXT:_default' \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--dir=[Devlog directory. Defaults to detecting docs/devlog or docs/source/devlog]:DIR:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
'--month=[Restrict the search to one month]:YYYY-MM:_default' \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--dir=[Devlog directory. Defaults to detecting docs/devlog or docs/source/devlog]:DIR:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':term -- Term to search for:_default' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--dir=[Devlog directory. Defaults to detecting docs/devlog or docs/source/devlog]:DIR:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(index)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--dir=[Devlog directory. Defaults to detecting docs/devlog or docs/source/devlog]:DIR:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--dir=[Devlog directory. Defaults to detecting docs/devlog or docs/source/devlog]:DIR:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- Shell to generate for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_devlog__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:devlog-help-command-$line[1]:"
        case $line[1] in
            (new)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(index)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_devlog_commands] )) ||
_devlog_commands() {
    local commands; commands=(
'new:Add an entry to its month file, creating the file and index link when absent' \
'search:Search entries for a literal, case-insensitive term' \
'check:Report structural problems\: month filenames, index drift, entry shape, ordering' \
'index:Rewrite the README month index from the tracked month files' \
'completion:Export shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'devlog commands' commands "$@"
}
(( $+functions[_devlog__subcmd__check_commands] )) ||
_devlog__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'devlog check commands' commands "$@"
}
(( $+functions[_devlog__subcmd__completion_commands] )) ||
_devlog__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'devlog completion commands' commands "$@"
}
(( $+functions[_devlog__subcmd__help_commands] )) ||
_devlog__subcmd__help_commands() {
    local commands; commands=(
'new:Add an entry to its month file, creating the file and index link when absent' \
'search:Search entries for a literal, case-insensitive term' \
'check:Report structural problems\: month filenames, index drift, entry shape, ordering' \
'index:Rewrite the README month index from the tracked month files' \
'completion:Export shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'devlog help commands' commands "$@"
}
(( $+functions[_devlog__subcmd__help__subcmd__check_commands] )) ||
_devlog__subcmd__help__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'devlog help check commands' commands "$@"
}
(( $+functions[_devlog__subcmd__help__subcmd__completion_commands] )) ||
_devlog__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'devlog help completion commands' commands "$@"
}
(( $+functions[_devlog__subcmd__help__subcmd__help_commands] )) ||
_devlog__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'devlog help help commands' commands "$@"
}
(( $+functions[_devlog__subcmd__help__subcmd__index_commands] )) ||
_devlog__subcmd__help__subcmd__index_commands() {
    local commands; commands=()
    _describe -t commands 'devlog help index commands' commands "$@"
}
(( $+functions[_devlog__subcmd__help__subcmd__new_commands] )) ||
_devlog__subcmd__help__subcmd__new_commands() {
    local commands; commands=()
    _describe -t commands 'devlog help new commands' commands "$@"
}
(( $+functions[_devlog__subcmd__help__subcmd__search_commands] )) ||
_devlog__subcmd__help__subcmd__search_commands() {
    local commands; commands=()
    _describe -t commands 'devlog help search commands' commands "$@"
}
(( $+functions[_devlog__subcmd__index_commands] )) ||
_devlog__subcmd__index_commands() {
    local commands; commands=()
    _describe -t commands 'devlog index commands' commands "$@"
}
(( $+functions[_devlog__subcmd__new_commands] )) ||
_devlog__subcmd__new_commands() {
    local commands; commands=()
    _describe -t commands 'devlog new commands' commands "$@"
}
(( $+functions[_devlog__subcmd__search_commands] )) ||
_devlog__subcmd__search_commands() {
    local commands; commands=()
    _describe -t commands 'devlog search commands' commands "$@"
}

if [ "$funcstack[1]" = "_devlog" ]; then
    _devlog "$@"
else
    compdef _devlog devlog
fi

_speech-test-cli__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli help completion commands' commands "$@"
}
(( $+functions[_speech-test-cli__subcmd__help__subcmd__generate_commands] )) ||
_speech-test-cli__subcmd__help__subcmd__generate_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli help generate commands' commands "$@"
}

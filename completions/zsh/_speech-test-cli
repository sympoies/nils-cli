#compdef speech-test-cli

autoload -U is-at-least

_speech-test-cli() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_speech-test-cli_commands" \
"*::: :->speech-test-cli" \
&& ret=0
    case $state in
    (speech-test-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:speech-test-cli-command-$line[1]:"
        case $line[1] in
            (generate)
_arguments "${_arguments_options[@]}" : \
'--catalog=[Path to the fixture catalog file]:CATALOG:_files' \
'--max-characters=[]:MAX_CHARACTERS:_default' \
'--cost-per-1000-characters=[]:COST_PER_1000_CHARACTERS:_default' \
'--cache-dir=[]:CACHE_DIR:_files' \
'--request-deadline-seconds=[]:REQUEST_DEADLINE_SECONDS:_default' \
'--format=[]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--plan[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(review)
_arguments "${_arguments_options[@]}" : \
'--catalog=[Path to the fixture catalog file]:CATALOG:_files' \
'--id=[]:ID:_default' \
'--reference=[]:REFERENCE:_default' \
'--reviewer=[]:REVIEWER:_default' \
'--format=[]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(replay)
_arguments "${_arguments_options[@]}" : \
'--catalog=[Path to the fixture catalog file]:CATALOG:_files' \
'--endpoint=[]:ENDPOINT:_default' \
'--deadline-seconds=[]:DEADLINE_SECONDS:_default' \
'--auth-env=[]:AUTH_ENV:_default' \
'--body=[]:BODY:(raw multipart)' \
'--multipart-field=[]:MULTIPART_FIELD:_default' \
'--run-output=[]:RUN_OUTPUT:_files' \
'--format=[]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--normalize[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(score)
_arguments "${_arguments_options[@]}" : \
'--run=[]:RUN:_files' \
'--format=[]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--format=[]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_speech-test-cli__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:speech-test-cli-help-command-$line[1]:"
        case $line[1] in
            (generate)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(review)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(replay)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(score)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_speech-test-cli_commands] )) ||
_speech-test-cli_commands() {
    local commands; commands=(
'generate:List TTS requests and estimated character cost; --plan never calls the provider' \
'review:Record a human review and spoken reference for a generated fixture' \
'replay:Replay verified, reviewed fixture audio against one ASR HTTP endpoint' \
'score:Re-emit scores from a saved run without network access' \
'completion:Print generated shell completions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'speech-test-cli commands' commands "$@"
}
(( $+functions[_speech-test-cli__subcmd__completion_commands] )) ||
_speech-test-cli__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli completion commands' commands "$@"
}

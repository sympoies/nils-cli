}
(( $+functions[_speech-test-cli__subcmd__help__subcmd__replay_commands] )) ||
_speech-test-cli__subcmd__help__subcmd__replay_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli help replay commands' commands "$@"
}
(( $+functions[_speech-test-cli__subcmd__help__subcmd__review_commands] )) ||
_speech-test-cli__subcmd__help__subcmd__review_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli help review commands' commands "$@"
}
(( $+functions[_speech-test-cli__subcmd__help__subcmd__score_commands] )) ||
_speech-test-cli__subcmd__help__subcmd__score_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli help score commands' commands "$@"
}
(( $+functions[_speech-test-cli__subcmd__replay_commands] )) ||
_speech-test-cli__subcmd__replay_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli replay commands' commands "$@"
}
(( $+functions[_speech-test-cli__subcmd__review_commands] )) ||
_speech-test-cli__subcmd__review_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli review commands' commands "$@"
}
(( $+functions[_speech-test-cli__subcmd__score_commands] )) ||
_speech-test-cli__subcmd__score_commands() {
    local commands; commands=()
    _describe -t commands 'speech-test-cli score commands' commands "$@"
}

if [ "$funcstack[1]" = "_speech-test-cli" ]; then
    _speech-test-cli "$@"
else
    compdef _speech-test-cli speech-test-cli
fi

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sympoies/nils-cli/blob/main/crates/research-cli/docs/specs/schema.json",
  "title": "Research request and CLI/HTTP envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/envelope"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "research.request.v1"
        },
        "operation": {
          "enum": [
            "search",
            "read-url",
            "brief"
          ]
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 16384
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recency_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "provider"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "max_redirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "max_tool_uses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "final_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "final_url",
        "title",
        "published_at"
      ]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "label": {
          "const": "model_inference"
        },
        "generated": {
          "type": "boolean"
        },
        "key_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_directions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preliminary_judgment": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "label",
        "generated",
        "key_points",
        "suggested_directions",
        "preliminary_judgment",
        "confidence"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "search_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd_estimate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "price_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "search_calls",
        "input_tokens",
        "output_tokens",
        "cost_usd_estimate",
        "price_source",
        "raw"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            null
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "claim",
              "source_ids"
            ]
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "query",
        "provider",
        "model",
        "retrieved_at",
        "sources",
        "facts",
        "summary",
        "assessment",
        "unknowns",
        "conflicts",
        "usage",
        "warnings",
        "truncated"
      ]
    },
    "envelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "cli.research-cli.search.v1",
            "cli.research-cli.read-url.v1",
            "cli.research-cli.brief.v1",
            "cli.research-cli.error.v1"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "data": {
          "$ref": "#/$defs/result"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "hint": {
              "type": "string"
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "schema_version",
        "ok"
      ]
    }
  }
}
